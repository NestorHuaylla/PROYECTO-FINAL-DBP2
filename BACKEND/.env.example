# Copia este archivo como ".env" y completa con tus valores reales.
# NUNCA subas el archivo ".env" real a git (ya está en .gitignore).

# Cadena de conexión a PostgreSQL
# Formato: postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD
DATABASE_URL="postgresql://neondb_owner:npg_j1RWwgzaIy7U@ep-polished-firefly-axi7fu5h.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Puerto donde corre la API NestJS
PORT=3000

# Clave secreta para firmar los JWT de autenticación
# Genera una tuya con: openssl rand -base64 32
JWT_SECRET="cambia-esto-por-un-secreto-real"
JWT_EXPIRES_IN="7d"

# Credenciales OAuth de Google (para la integración con Gmail API)
# Se obtienen en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/gmail/callback"
